@page "/category/{Slug}"
@using wowmenfashions.Services
@using wowmenfashions.Models
@using wowmenfashions.Components.Shared
@inject IProductService ProductService

<PageTitle>@_pageTitle - WOWMENFASHIONS</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pt-1 pb-4">
    <!-- Breadcrumb Area -->
    <MudBreadcrumbs Items="_breadcrumbs" Class="px-0 mb-2" />

    <!-- Filters Row (Mobile First, Stacks on small screens) -->
    <MudPaper Elevation="0" Class="pa-2 mb-4 border-bottom" Style="background-color: transparent !important;">
        <MudGrid Spacing="2" Justify="Justify.FlexStart" Class="align-end">
            
            <!-- Primary Categories -->
            <MudItem xs="12" sm="6" md="3">
                <MudSelect T="string" Label="Category" Value="@Slug" ValueChanged="NavigateToCategory" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense">
                    @foreach (var cat in _primaryCategories)
                    {
                        <MudSelectItem Value="@cat.Slug">@cat.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <!-- Subcategories (Cascading) -->
            @if (_subCategories.Any())
            {
                <MudItem xs="12" sm="6" md="3">
                    <MudSelect T="string" Label="Subcategory" Value="@_selectedSubcategorySlug" ValueChanged="SetSubcategoryFilter" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense">
                        <MudSelectItem T="string" Value="@(string.Empty)">All @(_currentCategory?.Name)</MudSelectItem>
                        @foreach (var sub in _subCategories)
                        {
                            <MudSelectItem T="string" Value="@sub.Slug">@sub.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            }

            <!-- Price Range -->
            <MudItem xs="12" sm="6" md="3">
                <div class="d-flex align-center mt-1">
                    <MudText Typo="Typo.caption" Class="me-2 text-nowrap">Up to ₹@_maxPrice</MudText>
                    <div class="px-4 flex-grow-1">
                        <MudSlider @bind-Value="_maxPrice" Min="0" Max="3000" Step="50" ValueLabel="true" Color="Color.Primary" Size="Size.Small" />
                    </div>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Class="ms-2 rounded-pill" OnClick="ApplyFilters">Apply</MudButton>
                </div>
            </MudItem>

        </MudGrid>
    </MudPaper>

    <!-- Product Grid Header -->
    <div class="d-flex align-center mb-4">
        <MudText Typo="Typo.caption" Class="text-muted">Showing @(_products.Count()) of @_totalItems results</MudText>
        <MudSpacer />
        <div style="width: 200px;">
            <MudSelect T="string" @bind-Value="_sortBy" Variant="Variant.Outlined" Margin="Margin.Dense" Class="sorting-select">
                <MudSelectItem Value="@("default")">Default sorting</MudSelectItem>
                <MudSelectItem Value="@("popularity")">Sort by popularity</MudSelectItem>
                <MudSelectItem Value="@("latest")">Sort by latest</MudSelectItem>
                <MudSelectItem Value="@("price-asc")">Sort by price: low to high</MudSelectItem>
                <MudSelectItem Value="@("price-desc")">Sort by price: high to low</MudSelectItem>
            </MudSelect>
        </div>
    </div>

    <!-- Products -->
    @if (_isLoading)
    {
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" Class="d-block mx-auto mt-8" />
    }
    else if (!_products.Any())
    {
        <MudAlert Severity="Severity.Info">No products found matching your criteria.</MudAlert>
    }
    else
    {
        <MudGrid Spacing="4">
            @foreach (var product in GetSortedProducts())
            {
                <MudItem xs="12" sm="6" md="4" lg="3">
                    <ProductCard Product="product" />
                </MudItem>
            }
        </MudGrid>
        <div class="d-flex justify-center mt-6">
            <MudPagination Count="@((_totalItems + _pageSize - 1) / _pageSize)" Selected="@_page" SelectedChanged="PageChanged" Color="Color.Primary" />
        </div>
    }
</MudContainer>

@code {
    [Parameter]
    public string Slug { get; set; } = string.Empty;

    [Inject]
    private NavigationManager Navigation { get; set; } = null!;

    private bool _isLoading = true;
    private IEnumerable<ProductDto> _products = new List<ProductDto>();
    private List<BreadcrumbItem> _breadcrumbs = new();
    
    // Filter State
    private int _maxPrice = 3000;
    private string? _selectedColor = null;
    private string? _selectedSubcategorySlug = null;
    private string _sortBy = "default";
    private int _page = 1;
    private int _pageSize = 20;
    private int _totalItems = 0;
    
    // Data Lookups
    private IEnumerable<CategoryDto> _allCategories = new List<CategoryDto>();
    private IEnumerable<CategoryDto> _primaryCategories = new List<CategoryDto>();
    private IEnumerable<CategoryDto> _subCategories = new List<CategoryDto>();
    private CategoryDto? _currentCategory;
    private IEnumerable<string> _allColors = new List<string>();

    private string _pageTitle => string.IsNullOrEmpty(Slug) ? "Products" : char.ToUpper(Slug[0]) + Slug.Substring(1);

    protected override async Task OnInitializedAsync()
    {
        _allCategories = await ProductService.GetCategoriesHierarchyAsync();
        _primaryCategories = _allCategories.Where(c => c.ParentId == null);
        _allColors = await ProductService.GetColorsAsync();
    }

    private string? _previousSlug;

    protected override async Task OnParametersSetAsync()
    {
        if (_previousSlug != Slug)
        {
            _previousSlug = Slug;
            _maxPrice = 3000;
            _selectedColor = null;
            _selectedSubcategorySlug = null;
            _sortBy = "default";
            _page = 1;
        }

        _breadcrumbs = new List<BreadcrumbItem>
        {
            new BreadcrumbItem("Home", href: "/"),
            new BreadcrumbItem(_pageTitle, href: null, disabled: true)
        };

        _currentCategory = _allCategories.FirstOrDefault(c => c.Slug.Equals(Slug, StringComparison.OrdinalIgnoreCase));
        if (_currentCategory != null)
        {
            _subCategories = _allCategories.Where(c => c.ParentId == _currentCategory.Id).ToList();
        }
        else
        {
            _subCategories = new List<CategoryDto>();
        }
        
        await LoadProductsAsync();
    }

    private async Task LoadProductsAsync()
    {
        _isLoading = true;
        // If a subcategory is selected, query by that slug, otherwise query by the parent slug
        var targetSlug = string.IsNullOrEmpty(_selectedSubcategorySlug) ? Slug : _selectedSubcategorySlug;
        var result = await ProductService.GetProductsAsync(targetSlug, _selectedColor, 0, _maxPrice, _page, _pageSize);
        _products = result.Products;
        _totalItems = result.TotalCount;
        _isLoading = false;
    }

    private async Task PageChanged(int page)
    {
        _page = page;
        await LoadProductsAsync();
    }

    private async Task ApplyFilters()
    {
        _page = 1;
        await LoadProductsAsync();
    }

    private async Task SetSubcategoryFilter(string? subcategorySlug)
    {
        _selectedSubcategorySlug = subcategorySlug;
        _page = 1;
        await LoadProductsAsync();
    }

    private void NavigateToCategory(string categorySlug)
    {
        if (categorySlug != Slug)
        {
            Navigation.NavigateTo($"/category/{categorySlug}");
        }
    }

    private IEnumerable<ProductDto> GetSortedProducts()
    {
        return _sortBy switch
        {
            "price-asc" => _products.OrderBy(p => p.Price),
            "price-desc" => _products.OrderByDescending(p => p.Price),
            "latest" => _products.OrderByDescending(p => p.Id),
            _ => _products // default
        };
    }
}
