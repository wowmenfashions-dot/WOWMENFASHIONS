@page "/contactus"
@using wowmenfashions.Models
@using wowmenfashions.Services
@inject IContactMessageService ContactMessageService
@inject IPageContentService PageContentService
@inject ISnackbar Snackbar

<PageTitle>Contact Us - WOWMEN FASHIONS</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-16 mb-16 px-4 px-md-16">
    <MudGrid Spacing="6">
        <!-- Left Column: Leave A Comment -->
        <MudItem xs="12" md="6">
            <MudText Typo="Typo.h4" Class="fw-bold mb-6">Leave A Comment</MudText>
            
            <EditForm Model="@_contactMessage" OnValidSubmit="HandleValidSubmit">
                <DataAnnotationsValidator />
                
                <MudGrid Spacing="3">
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_contactMessage.Name" For="@(() => _contactMessage.Name)" 
                                      Placeholder="Name" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_contactMessage.Email" For="@(() => _contactMessage.Email)" 
                                      Placeholder="Email" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField @bind-Value="_contactMessage.Subject" For="@(() => _contactMessage.Subject)" 
                                      Placeholder="Subject" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField @bind-Value="_contactMessage.Message" For="@(() => _contactMessage.Message)" 
                                      Placeholder="Leave a Message .." Variant="Variant.Outlined" Lines="6" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Dark" Class="mt-2 px-8 py-3 rounded-0" DropShadow="false" Disabled="_isSubmitting">
                            @( _isSubmitting ? "SUBMITTING..." : "SUBMIT")
                        </MudButton>
                    </MudItem>
                </MudGrid>
            </EditForm>
        </MudItem>

        <!-- Right Column: Information -->
        <MudItem xs="12" md="6" Class="d-flex flex-column justify-center pa-8" Style="background-color: #f7f7f7;">
            <MudText Typo="Typo.h4" Class="fw-bold mb-6">Information About Wowmen</MudText>
            
            @if (_isLoadingContent)
            {
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            }
            else if (!string.IsNullOrEmpty(_contentHtml))
            {
                @((MarkupString)_contentHtml)
            }
            else
            {
                <MudText Typo="Typo.body1" Class="mb-6 text-muted" Style="line-height: 1.8;">
                    At WOWMEN Fashions, we value your connection and eagerly await the opportunity to assist you.
                    Whether you have inquiries about our premium leather collections, need help with an order, or
                    want to share your experiences, our dedicated team is here for you. Reach out through our contact
                    form, drop us an email, or connect with us on social media. Your satisfaction is our priority, and
                    we look forward to providing you with the exceptional service that matches the quality of our
                    luxurious products. Elevate your experience with WOWMEN Fashions – where style meets unparalleled
                    customer care.
                </MudText>
                
                <MudList T="string" Class="bg-transparent mt-4">
                    <MudListItem Icon="@Icons.Material.Filled.Phone" IconColor="Color.Dark">
                        <MudText Typo="Typo.body1" Class="fw-bold">+91 9159933355</MudText>
                    </MudListItem>
                    <MudListItem Icon="@Icons.Material.Filled.Email" IconColor="Color.Dark">
                        <MudText Typo="Typo.body1" Class="fw-bold">
                            <MudLink Href="mailto:info@wowmenfashions.com" Color="Color.Dark">info@wowmenfashions.com</MudLink>
                        </MudText>
                    </MudListItem>
                </MudList>
            }
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    private ContactMessage _contactMessage = new();
    private bool _isSubmitting = false;
    
    private string _contentHtml = string.Empty;
    private bool _isLoadingContent = true;

    protected override async Task OnInitializedAsync()
    {
        var content = await PageContentService.GetContentByNameAsync("ContactUs");
        _contentHtml = content?.ContentHtml ?? string.Empty;
        _isLoadingContent = false;
    }

    private async Task HandleValidSubmit()
    {
        try
        {
            _isSubmitting = true;
            await ContactMessageService.CreateMessageAsync(_contactMessage);
            Snackbar.Add("Your message has been sent successfully!", Severity.Success);
            _contactMessage = new(); // Reset form
        }
        catch (Exception)
        {
            Snackbar.Add($"An error occurred while sending your message.", Severity.Error);
        }
    }
}
