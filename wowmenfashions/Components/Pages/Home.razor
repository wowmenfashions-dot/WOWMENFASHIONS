@page "/"
@using wowmenfashions.Services
@inject NavigationManager NavigationManager
@inject IHomepageConfigService HomepageConfigService

<PageTitle>WOWMENFASHIONS - Premium Leather Bags & Wallets</PageTitle>

<HeadContent>
    <meta name="description" content="Discover premium leather bags, wallets, and accessories at WOWMENFASHIONS. Enjoy 1-year guarantee, free delivery in India, and RFID protected products." />
    <meta name="keywords" content="leather bags, wallets, YKK zippers, RFID protection, WOWMENFASHIONS, men's fashion, women's fashion" />
    <meta property="og:title" content="WOWMENFASHIONS - Premium Leather Bags & Wallets" />
    <meta property="og:description" content="Discover premium leather bags, wallets, and accessories. Enjoy 1-year guarantee and free delivery." />
    <meta property="og:image" content="logo.png" />
</HeadContent>


<div class="homepage-container pb-16">
    @if (!string.IsNullOrEmpty(AnnouncementText))
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Filled" Square="true" Class="text-center py-2 mud-width-full" Style="border-radius: 0; background-color: #000;">
            <MudText Typo="Typo.subtitle1" Class="fw-bold text-white">@AnnouncementText</MudText>
        </MudAlert>
    }

    <!-- Main Carousel -->
    <MudCarousel Class="mud-width-full carousel-section" Style="height: 400px;" ItemsSource="@Images" AutoCycle="true">
        <ItemTemplate>
            <MudImage Src="@context" Style="width: 100%; height: 100%; object-fit: cover;" />
        </ItemTemplate>
    </MudCarousel>

    <!-- TRUST BANNERS (Guarantee, Delivery, RFID, YKK, LWG) -->
    <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mb-10 py-4" Style="background-color: #f9f9f9; border-bottom: 1px solid #eee;">
        <MudGrid Spacing="2" Justify="Justify.SpaceEvenly">
            <!-- Guarantee -->
            <MudItem xs="6" md="2" Class="d-flex align-center justify-center">
                <MudIcon Icon="@Icons.Material.Filled.WorkspacePremium" Size="Size.Medium" Color="Color.Warning" Class="mr-2" />
                <MudText Typo="Typo.body2" Class="fw-bold">1-Year Guarantee</MudText>
            </MudItem>
            <!-- Free Delivery -->
            <MudItem xs="6" md="2" Class="d-flex align-center justify-center">
                <MudIcon Icon="@Icons.Material.Filled.LocalShipping" Size="Size.Medium" Color="Color.Error" Class="mr-2" />
                <MudText Typo="Typo.body2" Class="fw-bold">Free Delivery</MudText>
            </MudItem>
            <!-- RFID -->
            <MudItem xs="6" md="2" Class="d-flex align-center justify-center">
                <MudIcon Icon="@Icons.Material.Filled.Security" Size="Size.Medium" Color="Color.Success" Class="mr-2" />
                <MudText Typo="Typo.body2" Class="fw-bold">RFID Protected</MudText>
            </MudItem>
            <!-- YKK -->
            <MudItem xs="6" md="2" Class="d-flex align-center justify-center">
                <MudIcon Icon="@Icons.Material.Filled.Hardware" Size="Size.Medium" Color="Color.Dark" Class="mr-2" />
                <MudText Typo="Typo.body2" Class="fw-bold">YKK Zippers</MudText>
            </MudItem>
            <!-- LWG -->
            <MudItem xs="6" md="2" Class="d-flex align-center justify-center">
                <MudIcon Icon="@Icons.Material.Filled.VerifiedUser" Size="Size.Medium" Color="Color.Primary" Class="mr-2" />
                <MudText Typo="Typo.body2" Class="fw-bold">LWG Certified</MudText>
            </MudItem>
        </MudGrid>
    </MudContainer>

    <!-- QUALITY OF PRODUCT SECTION -->
    <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mb-16 mt-8 px-4">
        <MudText Typo="Typo.h5" Align="Align.Center" Class="fw-bold mb-10 text-uppercase" Style="letter-spacing: 2px;">Quality of Product</MudText>
        
        <MudGrid Spacing="6" Justify="Justify.Center">
            <!-- YKK Zippers -->
            <MudItem xs="12" md="4" Class="d-flex align-start">
                <MudIcon Icon="@Icons.Material.Filled.Hardware" Size="Size.Large" Color="Color.Dark" Class="mr-4 mt-1" Style="font-size: 3rem;" />
                <div>
                    <MudText Typo="Typo.h6" Class="fw-bold mb-2">YKK Zippers</MudText>
                    <MudText Typo="Typo.body2" Class="text-muted" Style="line-height: 1.6;">
                        We use Zippers from the YKK Brand, Which is a Global leader in Fastening accessories. So, we are able to provide the worlds best quality zippers in our every products.
                    </MudText>
                </div>
            </MudItem>

            <!-- LWG Certification -->
            <MudItem xs="12" md="4" Class="d-flex align-start">
                <MudIcon Icon="@Icons.Material.Filled.VerifiedUser" Size="Size.Large" Color="Color.Success" Class="mr-4 mt-1" Style="font-size: 3rem;" />
                <div>
                    <MudText Typo="Typo.h6" Class="fw-bold mb-2">Leather Working Group</MudText>
                    <MudText Typo="Typo.body2" Class="text-muted" Style="line-height: 1.6;">
                        Our Leather Suppliers are Member of Leather Working Group and holding Silver and Gold LWG Certification. Their Leather Processing methods are bounded to US Standards.
                    </MudText>
                </div>
            </MudItem>

            <!-- Hardware/Accessories -->
            <MudItem xs="12" md="4" Class="d-flex align-start">
                <MudIcon Icon="@Icons.Material.Filled.Build" Size="Size.Large" Color="Color.Warning" Class="mr-4 mt-1" Style="font-size: 3rem;" />
                <div>
                    <MudText Typo="Typo.h6" Class="fw-bold mb-2">Premium Accessories</MudText>
                    <ul class="text-muted ps-4 mb-0" style="line-height: 1.6; font-size: 0.875rem;">
                        <li class="mb-2">Accessories we use on our products are Eco-friendly, Nickle&Lead free and BV certified.</li>
                        <li>Accessories are long lasting on color and rust</li>
                    </ul>
                </div>
            </MudItem>
        </MudGrid>
    </MudContainer>

    <!-- Removed old large banners, now consolidated at the top -->
</div>

@code {
    private List<string> Images = new();
    private string AnnouncementText = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        AnnouncementText = await HomepageConfigService.GetAnnouncementAsync();
        Images = await HomepageConfigService.GetCarouselImagesAsync();
    }
}

<style>
    .homepage-container {
        overflow-x: hidden;
    }
    .fw-bold { font-weight: bold; }
    .lh-1 { line-height: 1; }
    
    .discount-badge {
        position: absolute;
        right: -40px;
        top: 20px;
        background-color: #000;
        border-radius: 50%;
        width: 140px;
        height: 140px;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 2;
        border: 4px solid #f8f9fa;
        transform: rotate(-5deg);
    }
    
    .price-badge {
        background-color: #8c262a;
        padding: 15px 30px;
        clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }
    
    .vertical-text {
        position: absolute;
        left: -30px;
        top: 50%;
        transform: translateY(-50%) rotate(-90deg);
        letter-spacing: 4px;
        font-size: 0.8rem;
        color: #888;
        text-transform: uppercase;
    }
    
    .gallery-image {
        transition: transform 0.3s ease;
        overflow: hidden;
    }
    .gallery-image:hover {
        transform: scale(1.02);
    }
</style>
