@page "/product/{Id:int}"
@using wowmenfashions.Services
@using wowmenfashions.Models
@using wowmenfashions.Components.Shared
@inject IProductService ProductService
@inject ICartService CartService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>@(_product?.Name ?? "Product Details") - WOWMENFASHIONS</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4 mb-6">
    @if (_isLoading)
    {
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" Class="d-block mx-auto mt-8" />
    }
    else if (_product == null)
    {
        <MudAlert Severity="Severity.Error">Product not found.</MudAlert>
        <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="@(() => Navigation.NavigateTo("/"))" Class="mt-4">Return Home</MudButton>
    }
    else
    {
        <MudBreadcrumbs Items="_breadcrumbs" Class="px-0 mb-0" />
        
        <MudPaper Elevation="0" Class="pa-2 pa-md-4 bg-transparent">
            <MudGrid Spacing="2">
                <!-- Product Image -->
                <MudItem xs="12" md="6">
                    <MudCard Elevation="0" Class="overflow-hidden rounded-lg">
                        <MudCarousel Class="mud-width-full zoom-container" Style="height:400px;" ShowArrows="@(_product.AdditionalImages.Count > 0)" ShowBullets="@(_product.AdditionalImages.Count > 0)" EnableSwipeGesture="true" AutoCycle="false" TData="object">
                            <MudCarouselItem Transition="Transition.Slide">
                                <img src="@_product.ImageUrl" alt="@_product.Name" class="zoom-img" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.onerror=null; this.src='https://picsum.photos/seed/fallback/400/400.avif';" />
                            </MudCarouselItem>
                            @if (_product.AdditionalImages != null)
                            {
                                @foreach (var img in _product.AdditionalImages)
                                {
                                    <MudCarouselItem Transition="Transition.Slide">
                                        <img src="@img" alt="@_product.Name" class="zoom-img" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.onerror=null; this.src='https://picsum.photos/seed/fallback/400/400.avif';" />
                                    </MudCarouselItem>
                                }
                            }
                        </MudCarousel>
                    </MudCard>
                </MudItem>

                <!-- Product Info -->
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.caption" Color="Color.Default" Class="text-uppercase mb-1 d-block fw-bold tracking-widest">@_product.Category</MudText>
                    <MudText Typo="Typo.h4" Class="fw-bold mb-2" Style="font-family: 'Inter', sans-serif;">@_product.Name</MudText>
                    
                    <div class="d-flex align-center mb-4">
                        @if (_product.IsOnSale)
                        {
                            <MudText Typo="Typo.h6" Style="text-decoration: line-through" Class="me-2 text-muted">@_product.OriginalPrice?.ToString("C")</MudText>
                        }
                        <MudText Typo="Typo.h5" Color="@(_product.IsOnSale ? Color.Error : Color.Default)" Class="fw-bold">@_product.Price.ToString("C")</MudText>
                        
                        @if (_product.IsOnSale)
                        {
                            <MudChip T="string" Color="Color.Error" Size="Size.Small" Class="ms-4 px-3 fw-bold">SALE</MudChip>
                        }
                    </div>

                    <MudText Typo="Typo.body2" Class="mb-4 text-muted" Style="line-height: 1.5;">
                        @(_product.Description ?? "No description available for this product.")
                    </MudText>

                    <MudDivider Class="mb-4" />

                    <!-- Add to Cart Action -->
                    <div class="d-flex flex-wrap align-center gap-2 mb-4">
                        <MudNumericField @bind-Value="_quantity" Min="1" Max="10" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width: 100px;" />
                        <MudButton Variant="Variant.Filled" Color="Color.Dark" Size="Size.Small" StartIcon="@Icons.Material.Filled.ShoppingCart" OnClick="AddToCartAsync" Class="px-4 py-2 rounded-pill fw-bold flex-grow-1 flex-md-grow-0">
                            Add to Cart
                        </MudButton>
                    </div>

                    @if (_product.AvailableColors != null && _product.AvailableColors.Any())
                    {
                        <div class="mb-4">
                            <MudText Typo="Typo.subtitle2" Class="mb-2 fw-bold">Select Color:</MudText>
                            <div class="d-flex gap-2">
                                @foreach (var color in _product.AvailableColors)
                                {
                                    <div class="color-box @(_selectedColor as string == color ? "selected" : "")" 
                                         style="background-color: @color.ToLower();" 
                                         title="@color"
                                         @onclick="@(() => _selectedColor = color)">
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(_product.Color))
                    {
                        <MudText Typo="Typo.body2" Color="Color.Default" Class="mb-2">
                            <strong>Color:</strong> @_product.Color
                        </MudText>
                    }
                    <MudText Typo="Typo.body2" Color="Color.Default" Class="mb-2">
                        <strong>SKU:</strong> @(_product.Id.ToString("00000"))
                    </MudText>
                    <MudText Typo="Typo.body2" Color="Color.Default">
                        <strong>Category:</strong> <MudLink Href="@($"/category/{_product.Category.ToLower()}")" Color="Color.Dark">@_product.Category</MudLink>
                    </MudText>
                </MudItem>
            </MudGrid>
        </MudPaper>
    }
</MudContainer>

@code {
    [Parameter]
    public int Id { get; set; }

    private bool _isLoading = true;
    private ProductDto? _product;
    private int _quantity = 1;
    private object? _selectedColor;
    private List<BreadcrumbItem> _breadcrumbs = new();

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;
        _product = await ProductService.GetProductByIdAsync(Id);
        
        if (_product != null)
        {
            if (_product.AvailableColors != null && _product.AvailableColors.Any())
            {
                _selectedColor = _product.AvailableColors.First();
            }
            else
            {
                _selectedColor = _product.Color;
            }

            _breadcrumbs = new List<BreadcrumbItem>
            {
                new BreadcrumbItem("Home", href: "/"),
                new BreadcrumbItem(_product.Category, href: $"/category/{_product.Category.ToLower()}"),
                new BreadcrumbItem(_product.Name, href: null, disabled: true)
            };
        }
        
        _isLoading = false;
    }

    private async Task AddToCartAsync()
    {
        if (_product != null)
        {
            var colorStr = _selectedColor as string;
            if (_product.AvailableColors != null && _product.AvailableColors.Any() && string.IsNullOrEmpty(colorStr))
            {
                Snackbar.Add("Please select a color.", Severity.Warning);
                return;
            }

            try
            {
                await CartService.AddItemAsync(_product.Id, _quantity, colorStr);
                Snackbar.Add($"{_quantity} x {_product.Name} added to cart!", Severity.Success);
            }
            catch (Exception)
            {
                Snackbar.Add("Failed to add to cart.", Severity.Error);
            }
        }
    }
}

<style>
    .color-box {
        width: 30px;
        height: 30px;
        cursor: pointer;
        border: 2px solid transparent;
        border-radius: 4px;
        transition: transform 0.2s;
    }
    .color-box.selected {
        border-color: var(--mud-palette-primary);
        transform: scale(1.1);
        box-shadow: 0 0 5px rgba(0,0,0,0.3);
    }
    .zoom-container {
        overflow: hidden;
    }
    .zoom-img {
        transition: transform 0.3s ease;
    }
    .zoom-container:hover .zoom-img {
        transform: scale(1.5);
    }
</style>
