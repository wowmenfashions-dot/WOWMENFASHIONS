@page "/admin"
@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@using wowmenfashions.Models
@using wowmenfashions.Services
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<PageTitle>Admin Dashboard</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="my-8">
    <div class="d-flex justify-space-between align-center mb-6">
        <div>
            <MudText Typo="Typo.h4" Class="fw-bold">Product Management</MudText>
            <MudText Typo="Typo.body2" Color="Color.Surface">Manage your catalog, edit details, or remove products.</MudText>
        </div>
        <div class="d-flex gap-4">
            <MudButton Variant="Variant.Outlined" Color="Color.Dark" Href="/api/auth/logout" Class="rounded-pill px-6 fw-bold">Logout</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Dark" Href="/admin/products/new" Class="rounded-pill px-6 fw-bold">Add Product</MudButton>
        </div>
    </div>

    <MudPaper Elevation="1" Style="border-radius: 8px; overflow: hidden;">
        <MudDataGrid T="ProductDto" Items="@_products" ReadOnly="true" Bordered="false" Dense="false" Hover="true" Striped="true" Style="white-space: nowrap;">
            <Columns>
                <TemplateColumn Title="Image" Sortable="false">
                    <CellTemplate>
                        <MudImage Src="@(string.IsNullOrEmpty(context.Item.ImageUrl) ? "https://placehold.co/100x100/F3F4F6/1E1E1E.avif?text=No+Image" : context.Item.ImageUrl)" Width="50" Height="50" ObjectFit="ObjectFit.Cover" Class="rounded" />
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.Id" Title="ID" />
                <PropertyColumn Property="x => x.Name" Title="Product Name" />
                <PropertyColumn Property="x => x.Category" Title="Category" />
                <PropertyColumn Property="x => x.Price" Title="Price" Format="C" />
                <PropertyColumn Property="x => x.OriginalPrice" Title="Original Price" Format="C" />
                <TemplateColumn Title="Actions" Sortable="false" CellClass="d-flex justify-end pr-4">
                    <CellTemplate>
                        <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit" Size="Size.Small" Class="fw-bold me-2" Href="@($"/admin/products/edit/{context.Item.Id}")">Edit</MudButton>
                        <MudButton Variant="Variant.Text" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" Size="Size.Small" Class="fw-bold" OnClick="@(() => DeleteProduct(context.Item))">Delete</MudButton>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <PagerContent>
                <MudDataGridPager T="ProductDto" />
            </PagerContent>
        </MudDataGrid>
    </MudPaper>
</MudContainer>

@code {
    [Inject] private IProductService ProductService { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;
    
    private IEnumerable<ProductDto> _products = new List<ProductDto>();

    protected override async Task OnInitializedAsync()
    {
        await LoadProducts();
    }

    private async Task LoadProducts()
    {
        var result = await ProductService.GetProductsAsync(pageSize: 1000);
        _products = result.Products;
    }

    private async Task DeleteProduct(ProductDto item)
    {
        bool result = await JSRuntime.InvokeAsync<bool>("confirm", $"Are you sure you want to delete '{item.Name}'?");

        if (result)
        {
            await ProductService.DeleteProductAsync(item.Id);
            Snackbar.Add("Product deleted successfully.", Severity.Success);
            await LoadProducts();
        }
    }
}
