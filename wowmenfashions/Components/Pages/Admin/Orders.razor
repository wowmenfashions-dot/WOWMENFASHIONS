@page "/admin/orders"
@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@using wowmenfashions.Models
@using wowmenfashions.Services
@using wowmenfashions.Data
@inject IOrderService OrderService
@inject ISnackbar Snackbar
@inject IEmailNotificationLogRepository EmailLogRepository

<PageTitle>Admin - Order Management</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <div class="d-flex justify-space-between align-center mb-4">
        <MudText Typo="Typo.h4">Order Management</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/admin">Products</MudButton>
    </div>

    <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" Class="mb-4" ActivePanelIndexChanged="OnTabChanged">
        <MudTabPanel Text="All" />
        <MudTabPanel Text="PaymentCompleted" />
        <MudTabPanel Text="Processing" />
        <MudTabPanel Text="InTransit" />
        <MudTabPanel Text="Delivered" />
        <MudTabPanel Text="Cancelled" />
    </MudTabs>
    
    <MudDataGrid T="OrderDto" Items="@FilteredOrders" ReadOnly="false" EditMode="DataGridEditMode.Form"
                 CommittedItemChanges="@( async (OrderDto item) => { await CommittedItemChanges(item); return default; } )"
                 Bordered="true" Dense="true">
        <ToolBarContent>
            <MudText Typo="Typo.h6">Orders</MudText>
            <MudSpacer />
        </ToolBarContent>
        <Columns>
            <HierarchyColumn T="OrderDto" />
            <PropertyColumn Property="x => x.Id" Title="ID" Editable="false" />
            <PropertyColumn Property="x => x.OrderDate" Title="Date" Editable="false" />
            <PropertyColumn Property="x => x.TotalAmount" Title="Total" Editable="false" />
            
            <TemplateColumn Title="Status">
                <CellTemplate>
                    <MudChip T="string" Color="Color.Primary" Size="Size.Small">@context.Item.Status</MudChip>
                </CellTemplate>
                <EditTemplate>
                    <MudSelect @bind-Value="context.Item.Status" Margin="Margin.Dense">
                        <MudSelectItem Value="@("PaymentCompleted")">PaymentCompleted</MudSelectItem>
                        <MudSelectItem Value="@("Processing")">Processing</MudSelectItem>
                        <MudSelectItem Value="@("InTransit")">InTransit</MudSelectItem>
                        <MudSelectItem Value="@("Delivered")">Delivered</MudSelectItem>
                        <MudSelectItem Value="@("Cancelled")">Cancelled</MudSelectItem>
                    </MudSelect>
                </EditTemplate>
            </TemplateColumn>

            <PropertyColumn Property="x => x.PaymentStatus" Title="Payment Status" Editable="false" />
            <PropertyColumn Property="x => x.RazorpayOrderId" Title="Razorpay Order ID" Editable="false" />
            <PropertyColumn Property="x => x.RazorpayPaymentId" Title="Razorpay Payment ID" Editable="false" />

            <PropertyColumn Property="x => x.CourierName" Title="Courier" />
            <PropertyColumn Property="x => x.TrackingNumber" Title="Tracking No." />
            <PropertyColumn Property="x => x.TrackingUrl" Title="Tracking URL" />
            
            <TemplateColumn Title="Email Status" Editable="false">
                <CellTemplate>
                    @if (_orderEmailLogs.TryGetValue(context.Item.Id, out var log))
                    {
                        @if (log.Status == "Sent")
                        {
                            <MudChip T="string" Color="Color.Success" Size="Size.Small">✉ Email Sent (@log.SentAt.ToString("g"))</MudChip>
                        }
                        else if (log.Status == "Failed")
                        {
                            <MudChip T="string" Color="Color.Error" Size="Size.Small">✉ Email Failed</MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Color="Color.Default" Size="Size.Small">✉ @log.Status</MudChip>
                        }
                    }
                    else
                    {
                        <MudChip T="string" Color="Color.Default" Size="Size.Small">✉ No Email</MudChip>
                    }
                </CellTemplate>
            </TemplateColumn>
            
            <TemplateColumn Title="Actions">
                <CellTemplate>
                    <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Edit" OnClick="@context.Actions.StartEditingItemAsync" />
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <ChildRowContent>
            <MudCard Elevation="0" Class="pa-4 bg-light">
                <MudText Typo="Typo.subtitle1" Class="fw-bold mb-2">Order Items:</MudText>
                @if (context.Item.Items != null && context.Item.Items.Any())
                {
                    <MudTable Items="@context.Item.Items" Dense="true" Elevation="0">
                        <HeaderContent>
                            <MudTh>Product</MudTh>
                            <MudTh>Color</MudTh>
                            <MudTh>Size</MudTh>
                            <MudTh>Qty</MudTh>
                            <MudTh>Price</MudTh>
                        </HeaderContent>
                        <RowTemplate Context="itemContext">
                            <MudTd DataLabel="Product">@itemContext.ProductName</MudTd>
                            <MudTd DataLabel="Color">@(string.IsNullOrEmpty(itemContext.SelectedColor) ? "N/A" : itemContext.SelectedColor)</MudTd>
                            <MudTd DataLabel="Size">@(string.IsNullOrEmpty(itemContext.SelectedSize) ? "N/A" : itemContext.SelectedSize)</MudTd>
                            <MudTd DataLabel="Qty">@itemContext.Quantity</MudTd>
                            <MudTd DataLabel="Price">@itemContext.Price.ToString("C")</MudTd>
                        </RowTemplate>
                    </MudTable>
                }
                else
                {
                    <MudText Typo="Typo.body2">No items found for this order.</MudText>
                }
            </MudCard>
        </ChildRowContent>
    </MudDataGrid>
</MudContainer>

@code {
    private IEnumerable<OrderDto> _orders = new List<OrderDto>();
    private string _activeTab = "All";
    private Dictionary<int, EmailNotificationLogDto> _orderEmailLogs = new();

    private IEnumerable<OrderDto> FilteredOrders => _activeTab == "All" 
        ? _orders 
        : _orders.Where(o => o.Status == _activeTab);

    protected override async Task OnInitializedAsync()
    {
        await LoadOrders();
    }

    private void OnTabChanged(int index)
    {
        _activeTab = index switch
        {
            0 => "All",
            1 => "PaymentCompleted",
            2 => "Processing",
            3 => "InTransit",
            4 => "Delivered",
            5 => "Cancelled",
            _ => "All"
        };
    }

    private async Task LoadOrders()
    {
        _orders = await OrderService.GetAllOrdersAsync();
        _orderEmailLogs.Clear();
        foreach (var order in _orders)
        {
            var logs = await EmailLogRepository.GetByOrderIdAsync(order.Id);
            var latestLog = logs.FirstOrDefault();
            if (latestLog != null)
            {
                _orderEmailLogs[order.Id] = latestLog;
            }
        }
    }

    private async Task CommittedItemChanges(OrderDto item)
    {
        await OrderService.UpdateOrderStatusAsync(item.Id, item.Status);
        await OrderService.UpdateOrderTrackingAsync(item.Id, item.CourierName ?? "", item.TrackingNumber ?? "", item.TrackingUrl ?? "");
        Snackbar.Add($"Order #{item.Id} updated successfully", Severity.Success);
        await LoadOrders();
        StateHasChanged();
    }
}
