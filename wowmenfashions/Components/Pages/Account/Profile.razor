@page "/account/profile"
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@using wowmenfashions.Services
@using wowmenfashions.Models
@attribute [Authorize]
@inject ICustomerService CustomerService
@inject AuthenticationStateProvider AuthStateProvider
@inject ISnackbar Snackbar

<PageTitle>My Profile - WOWMENFASHIONS</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-8">
    <MudText Typo="Typo.h4" Class="mb-6">My Profile</MudText>

    <MudGrid>
        <MudItem xs="12" md="4">
            <MudPaper Class="pa-4">
                <MudNavMenu>
                    <MudNavLink Href="/account/profile" Icon="@Icons.Material.Filled.Person">Profile Information</MudNavLink>
                    <MudNavLink Href="/account/orders" Icon="@Icons.Material.Filled.ShoppingBag">Order History</MudNavLink>
                </MudNavMenu>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="8">
            <MudPaper Class="pa-6">
                @if (_isLoading)
                {
                    <MudProgressCircular Indeterminate="true" />
                }
                else
                {
                    <MudForm @ref="_form" @bind-IsValid="@_success">
                        <MudTextField @bind-Value="_model.FirstName" Label="First Name" Required="true" RequiredError="First name is required" Class="mb-4" />
                        <MudTextField @bind-Value="_model.LastName" Label="Last Name" Required="true" RequiredError="Last name is required" Class="mb-4" />
                        <MudTextField @bind-Value="_model.Email" Label="Email Address" Disabled="true" Class="mb-4" HelperText="Email cannot be changed." />
                        <MudTextField @bind-Value="_model.Phone" Label="Phone Number (Optional)" Class="mb-6" />

                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" 
                                   Disabled="@(!_success || _isProcessing)" OnClick="UpdateProfile">
                            @if (_isProcessing)
                            {
                                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true"/>
                                <MudText Class="ms-2">Saving...</MudText>
                            }
                            else
                            {
                                <MudText>Save Changes</MudText>
                            }
                        </MudButton>
                    </MudForm>
                }
            </MudPaper>

            <!-- Addresses Section -->
            <MudPaper Class="pa-6 mt-6">
                <MudText Typo="Typo.h5" Class="mb-4">My Addresses</MudText>
                @if (_isLoading)
                {
                    <MudProgressCircular Indeterminate="true" />
                }
                else
                {
                    <MudGrid>
                        @foreach (var addr in _addresses)
                        {
                            <MudItem xs="12" sm="6">
                                <MudCard Elevation="2" Class="mb-4">
                                    <MudCardHeader>
                                        <CardHeaderContent>
                                            <MudText Typo="Typo.subtitle1" Class="fw-bold">@addr.FullName</MudText>
                                        </CardHeaderContent>
                                        <CardHeaderActions>
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(() => DeleteAddress(addr.Id))" />
                                        </CardHeaderActions>
                                    </MudCardHeader>
                                    <MudCardContent>
                                        <MudText Typo="Typo.body2">@addr.AddressLine</MudText>
                                        <MudText Typo="Typo.body2">@addr.City, @addr.PostalCode</MudText>
                                        <MudText Typo="Typo.body2">@addr.Country</MudText>
                                        @if (addr.IsDefaultShipping)
                                        {
                                            <MudChip T="string" Color="Color.Primary" Size="Size.Small" Class="mt-2">Default Shipping</MudChip>
                                        }
                                    </MudCardContent>
                                </MudCard>
                            </MudItem>
                        }
                    </MudGrid>

                    <MudDivider Class="my-6" />
                    <MudText Typo="Typo.h6" Class="mb-4">Add New Address</MudText>
                    
                    <MudForm @ref="_addressForm" @bind-IsValid="@_addressSuccess">
                        <MudTextField @bind-Value="_newAddress.FullName" Label="Full Name" Required="true" Class="mb-4" />
                        <MudTextField @bind-Value="_newAddress.AddressLine" Label="Address Line" Required="true" Class="mb-4" />
                        <MudGrid>
                            <MudItem xs="6">
                                <MudTextField @bind-Value="_newAddress.City" Label="City" Required="true" Class="mb-4" />
                            </MudItem>
                            <MudItem xs="6">
                                <MudTextField @bind-Value="_newAddress.PostalCode" Label="Postal Code" Required="true" Class="mb-4" />
                            </MudItem>
                        </MudGrid>
                        <MudTextField @bind-Value="_newAddress.Country" Label="Country" Required="true" Class="mb-4" />
                        <MudCheckBox @bind-Value="_newAddress.IsDefaultShipping" Label="Set as Default Shipping" Class="mb-4" />
                        
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!_addressSuccess)" OnClick="SaveAddress">
                            Save Address
                        </MudButton>
                    </MudForm>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    private MudForm _form = null!;
    private bool _success;
    private bool _isLoading = true;
    private bool _isProcessing = false;
    private int _customerId;
    private ProfileModel _model = new();
    
    private IEnumerable<CustomerAddressDto> _addresses = new List<CustomerAddressDto>();
    private CustomerAddressDto _newAddress = new();
    private MudForm _addressForm = null!;
    private bool _addressSuccess;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var idClaim = user.FindFirst(ClaimTypes.NameIdentifier);

        if (idClaim != null && int.TryParse(idClaim.Value, out _customerId))
        {
            var customer = await CustomerService.GetCustomerProfileAsync(_customerId);
            if (customer != null)
            {
                _model.FirstName = customer.FirstName;
                _model.LastName = customer.LastName;
                _model.Email = customer.Email;
                _model.Phone = customer.Phone;
                
                await LoadAddressesAsync();
            }
        }
        
        _isLoading = false;
    }

    private async Task UpdateProfile()
    {
        await _form.ValidateAsync();
        if (_form.IsValid)
        {
            _isProcessing = true;
            try
            {
                var result = await CustomerService.UpdateProfileAsync(_customerId, _model.FirstName, _model.LastName, _model.Phone);
                if (result.Success)
                {
                    Snackbar.Add("Profile updated successfully.", Severity.Success);
                }
                else
                {
                    Snackbar.Add(result.ErrorMessage, Severity.Error);
                }
            }
            finally
            {
                _isProcessing = false;
            }
        }
    }

    private async Task LoadAddressesAsync()
    {
        _addresses = await CustomerService.GetAddressesAsync(_customerId);
    }

    private async Task SaveAddress()
    {
        await _addressForm.ValidateAsync();
        if (_addressForm.IsValid)
        {
            _newAddress.CustomerId = _customerId;
            await CustomerService.SaveAddressAsync(_newAddress);
            Snackbar.Add("Address saved successfully", Severity.Success);
            _newAddress = new CustomerAddressDto(); // Reset form
            await LoadAddressesAsync();
            StateHasChanged();
        }
    }

    private async Task DeleteAddress(int addressId)
    {
        await CustomerService.DeleteAddressAsync(addressId);
        Snackbar.Add("Address deleted", Severity.Info);
        await LoadAddressesAsync();
        StateHasChanged();
    }

    public class ProfileModel
    {
        public string FirstName { get; set; } = string.Empty;
        public string LastName { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string? Phone { get; set; }
    }
}
