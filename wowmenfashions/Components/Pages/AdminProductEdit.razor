@page "/admin/products/edit/{Id:int}"
@using Microsoft.AspNetCore.Authorization
@using wowmenfashions.Components.Shared
@attribute [Authorize(Roles = "Admin")]
@using wowmenfashions.Models
@using wowmenfashions.Services
@using ImageMagick
@inject IProductService ProductService
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment WebHostEnvironment

<PageTitle>Edit Product | Admin</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="my-8">
    <div class="d-flex align-center justify-space-between mb-6">
        <div>
            <MudText Typo="Typo.h4" Class="fw-bold">Edit Product</MudText>
            <MudText Typo="Typo.body2" Color="Color.Surface">Update details for your catalog item.</MudText>
        </div>
        <MudButton Variant="Variant.Outlined" Color="Color.Dark" Href="/admin" StartIcon="@Icons.Material.Filled.ArrowBack">Back</MudButton>
    </div>

    @if (_isLoading)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Class="d-block mx-auto mt-10" />
    }
    else if (_product == null)
    {
        <MudAlert Severity="Severity.Error">Product not found.</MudAlert>
    }
    else
    {
        <ErrorBoundary>
            <ErrorContent>
                <MudAlert Severity="Severity.Error">@context.Message</MudAlert>
                <pre>@context.StackTrace</pre>
            </ErrorContent>
            <ChildContent>
                <EditForm Model="@_product" OnValidSubmit="HandleSubmitAsync">
                    <DataAnnotationsValidator />
                    
                    <MudGrid>
                        <!-- Left Column (Main Content) -->
                        <MudItem xs="12" md="8">
                            
                            <!-- Basic Info Card -->
                            <MudPaper Class="pa-6 mb-6" Elevation="1" Style="border-radius: 8px;">
                                <MudText Typo="Typo.h6" Class="mb-4 fw-bold">Basic Information</MudText>
                                <MudDivider Class="mb-6" />
                                
                                <MudTextField @bind-Value="_product.Name" Label="Product Name" Required="true" Variant="Variant.Outlined" Class="mb-4" />
                                
                                <div class="mb-4">
                                    <MudText Typo="Typo.subtitle2" Class="mb-2 fw-bold" Style="color: #555;">Description (Product Details)</MudText>
                                    <QuillEditor @bind-Content="_product.Description" MinHeight="150px" />
                                </div>
                                
                                <div class="mb-4">
                                    <MudText Typo="Typo.subtitle2" Class="mb-2 fw-bold" Style="color: #555;">Specifications</MudText>
                                    <QuillEditor @bind-Content="_product.Specifications" MinHeight="150px" />
                                </div>
                                
                                <div class="mb-4">
                                    <MudText Typo="Typo.subtitle2" Class="mb-2 fw-bold" Style="color: #555;">Shipping & Returns</MudText>
                                    <QuillEditor @bind-Content="_product.ShippingReturns" MinHeight="150px" />
                                </div>
                            </MudPaper>

                            <!-- Media & Variants Card -->
                            <MudPaper Class="pa-6 mb-6" Elevation="1" Style="border-radius: 8px;">
                                <div class="d-flex align-center justify-space-between mb-4">
                                    <MudText Typo="Typo.h6" Class="fw-bold">Color Variants & Images</MudText>
                                    <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Text" Color="Color.Primary" OnClick="AddColorVariant">Add Color</MudButton>
                                </div>
                                <MudDivider Class="mb-6" />
                                
                                @if (!_colorVariants.Any())
                                {
                                    <MudAlert Severity="Severity.Info" Class="mb-4">No color variants added. The default fallback image will be used.</MudAlert>
                                }
                                
                                @foreach (var cv in _colorVariants)
                                {
                                    <MudPaper Elevation="0" Class="pa-4 mb-4" Style="border: 1px solid #e0e0e0; border-radius: 6px;">
                                        <MudGrid Class="align-center">
                                            <MudItem xs="12" sm="2">
                                                <MudColorPicker @bind-Text="cv.ColorName" Label="Color" Variant="Variant.Outlined" Margin="Margin.Dense" DisableAlpha="true" />
                                            </MudItem>
                                            <MudItem xs="12" sm="2">
                                                <MudSelect @bind-Value="cv.Size" Label="Size" Variant="Variant.Outlined" Margin="Margin.Dense">
                                                    @foreach (var size in _availableSizeOptions)
                                                    {
                                                        <MudSelectItem Value="@size">@size</MudSelectItem>
                                                    }
                                                </MudSelect>
                                            </MudItem>
                                            <MudItem xs="12" sm="4">
                                                <MudTextField @bind-Value="cv.ImageUrl" Label="Image URL" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                            </MudItem>
                                            <MudItem xs="12" sm="3" Class="d-flex align-center">
                                                <div style="position: relative; overflow: hidden; display: inline-block;">
                                                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.CloudUpload" Size="Size.Small">
                                                        Upload
                                                    </MudButton>
                                                    <InputFile OnChange="@(async e => await UploadImageAsync(e.File, cv))" accept=".png, .jpg, .jpeg, .webp, .avif" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer;" />
                                                </div>
                                            </MudItem>
                                            <MudItem xs="12" sm="1" Class="d-flex justify-end">
                                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(() => _colorVariants.Remove(cv))" />
                                            </MudItem>
                                        </MudGrid>
                                    </MudPaper>
                                }
                            </MudPaper>
                        </MudItem>

                        <!-- Right Column (Sidebar Content) -->
                        <MudItem xs="12" md="4">
                            
                            <!-- Organization Card -->
                            <MudPaper Class="pa-6 mb-6" Elevation="1" Style="border-radius: 8px;">
                                <MudText Typo="Typo.h6" Class="mb-4 fw-bold">Organization</MudText>
                                <MudDivider Class="mb-6" />
                                
                                <MudSelect T="int" Value="_selectedCategoryId" ValueChanged="OnCategoryChanged" Label="Category" Required="true" Variant="Variant.Outlined" Class="mb-4">
                                    @foreach (var cat in _categories.Where(c => c.ParentId == null))
                                    {
                                        <MudSelectItem Value="@cat.Id">@cat.Name</MudSelectItem>
                                    }
                                </MudSelect>
                                
                                <MudSelect T="int" Value="_selectedSubCategoryId" ValueChanged="OnSubCategoryChanged" Label="Sub Category" Required="false" Variant="Variant.Outlined" Disabled="@(!_subCategories.Any())">
                                    @foreach (var sub in _subCategories)
                                    {
                                        <MudSelectItem Value="@sub.Id">@sub.Name</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudPaper>
                            
                            <!-- Pricing Card -->
                            <MudPaper Class="pa-6 mb-6" Elevation="1" Style="border-radius: 8px;">
                                <MudText Typo="Typo.h6" Class="mb-4 fw-bold">Pricing</MudText>
                                <MudDivider Class="mb-6" />
                                
                                <MudNumericField @bind-Value="_product.Price" Label="Price" Required="true" Min="0" Variant="Variant.Outlined" Adornment="Adornment.Start" AdornmentText="₹" Class="mb-4" />
                                <MudNumericField @bind-Value="_product.OriginalPrice" Label="Original Price (Compare at)" Min="0" Variant="Variant.Outlined" Adornment="Adornment.Start" AdornmentText="₹" />
                            </MudPaper>
                            
                            <!-- Sizes Card -->
                            <MudPaper Class="pa-6 mb-6" Elevation="1" Style="border-radius: 8px;">
                                <MudText Typo="Typo.h6" Class="mb-4 fw-bold">Sizes</MudText>
                                <MudDivider Class="mb-6" />
                                
                                <MudSelect T="string" @bind-SelectedValues="_selectedSizes" MultiSelection="true" Label="Available Sizes" SelectAll="true" SelectAllText="Select All" Variant="Variant.Outlined">
                                    @foreach (var size in _availableSizeOptions)
                                    {
                                        <MudSelectItem Value="@size">@size</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudPaper>
                            
                            <!-- Publish Action -->
                            <MudPaper Class="pa-6" Elevation="1" Style="border-radius: 8px; background-color: #f9fafb;">
                                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" FullWidth="true" Class="fw-bold py-3 rounded-pill">Update Product</MudButton>
                            </MudPaper>
                            
                        </MudItem>
                    </MudGrid>
                </EditForm>
            </ChildContent>
        </ErrorBoundary>
    }
</MudContainer>

@code {
    [Parameter]
    public int Id { get; set; }

    private bool _isLoading = true;
    private ProductDto? _product;
    private List<ColorVariantInput> _colorVariants = new List<ColorVariantInput>();
    private List<CategoryDto> _categories = new();
    private List<CategoryDto> _subCategories = new();
    private int _selectedCategoryId;
    private int _selectedSubCategoryId;
    
    private IReadOnlyCollection<string> _selectedSizes = new List<string>();
    private readonly string[] _availableSizeOptions = { "X-Small", "Small", "Medium", "Large", "X-Large", "XX-Large", "One Size" };
    private readonly string[] _availableColorOptions = { "Black", "White", "Grey", "Navy", "Blue", "Red", "Green", "Yellow", "Orange", "Pink", "Purple", "Brown", "Multicolor", "No-Color" };

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;
        
        _categories = (await ProductService.GetCategoriesHierarchyAsync()).ToList();
        _product = await ProductService.GetProductByIdAsync(Id);
        
        if (_product != null)
        {
            // Map Categories
            var productCat = _categories.FirstOrDefault(c => c.Id == _product.CategoryId);
            if (productCat != null)
            {
                if (productCat.ParentId == null)
                {
                    _selectedCategoryId = productCat.Id;
                    _subCategories = _categories.Where(c => c.ParentId == _selectedCategoryId).ToList();
                }
                else
                {
                    _selectedCategoryId = productCat.ParentId.Value;
                    _subCategories = _categories.Where(c => c.ParentId == _selectedCategoryId).ToList();
                    _selectedSubCategoryId = productCat.Id;
                }
            }

            // Map Sizes
            if (!string.IsNullOrEmpty(_product.AvailableSizes))
            {
                _selectedSizes = _product.AvailableSizes.Split(',').Select(s => s.Trim()).ToList();
            }

            // Map Colors
            if (_product.ColorImages != null)
            {
                foreach (var kvp in _product.ColorImages)
                {
                    if (!string.IsNullOrWhiteSpace(kvp.Value))
                    {
                        var parts = kvp.Key.Split('|');
                        var colorName = parts[0];
                        var sizeName = parts.Length > 1 ? parts[1] : string.Empty;

                        var urls = kvp.Value.Split(',', StringSplitOptions.RemoveEmptyEntries);
                        foreach (var url in urls)
                        {
                            _colorVariants.Add(new ColorVariantInput { ColorName = colorName, Size = sizeName, ImageUrl = url.Trim() });
                        }
                    }
                }
            }
        }
        
        _isLoading = false;
    }

    private void OnCategoryChanged(int categoryId)
    {
        _selectedCategoryId = categoryId;
        _subCategories = _categories.Where(c => c.ParentId == categoryId).ToList();
        _selectedSubCategoryId = 0; // Reset
    }

    private void OnSubCategoryChanged(int subCategoryId)
    {
        _selectedSubCategoryId = subCategoryId;
    }

    private void AddColorVariant()
    {
        _colorVariants.Add(new ColorVariantInput());
    }

    private async Task HandleSubmitAsync()
    {
        if (_product == null) return;
        
        try
        {
            var finalCatId = _selectedSubCategoryId > 0 ? _selectedSubCategoryId : _selectedCategoryId;
            var finalCat = _categories.FirstOrDefault(c => c.Id == finalCatId);
            if (finalCat == null)
            {
                Snackbar.Add("Please select a category.", Severity.Warning);
                return;
            }

            _product.CategoryId = finalCat.Id;
            _product.Category = finalCat.Slug;

            // Populate ColorImages dictionary from our UI list
            _product.ColorImages = new Dictionary<string, string>();
            foreach (var cv in _colorVariants)
            {
                if (!string.IsNullOrWhiteSpace(cv.ColorName) && !string.IsNullOrWhiteSpace(cv.ImageUrl))
                {
                    string key = string.IsNullOrWhiteSpace(cv.Size) ? cv.ColorName.Trim() : $"{cv.ColorName.Trim()}|{cv.Size.Trim()}";
                    if (_product.ColorImages.ContainsKey(key))
                    {
                        _product.ColorImages[key] += "," + cv.ImageUrl;
                    }
                    else
                    {
                        _product.ColorImages[key] = cv.ImageUrl;
                    }
                }
            }

            // Set default image to the first color's first image if available
            if (_product.ColorImages.Any())
            {
                var firstImageStr = _product.ColorImages.Values.First();
                _product.ImageUrl = firstImageStr.Split(',', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? firstImageStr;
                var firstKey = _product.ColorImages.Keys.First();
                _product.Color = firstKey.Split('|')[0];
            }
            else
            {
                _product.ImageUrl = "/images/dummy-product.avif";
            }

            _product.AvailableColors = string.Join(",", _product.ColorImages.Keys.Select(k => k.Split('|')[0]).Distinct());
            _product.AvailableSizes = string.Join(",", _selectedSizes);

            await ProductService.UpdateProductAsync(_product);
            Snackbar.Add($"Product '{_product.Name}' updated successfully!", Severity.Success);
            
            NavigationManager.NavigateTo("/admin");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error updating product: {ex.Message}", Severity.Error);
        }
    }

    public class ColorVariantInput
    {
        public string ColorName { get; set; } = string.Empty;
        public string Size { get; set; } = string.Empty;
        public string ImageUrl { get; set; } = string.Empty;
    }

    private async Task UploadImageAsync(IBrowserFile file, ColorVariantInput cv)
    {
        try
        {
            if (file == null) return;
            
            // Ensure uploads directory exists
            var uploadsFolder = Path.Combine(WebHostEnvironment.WebRootPath, "images", "products");
            if (!Directory.Exists(uploadsFolder))
            {
                Directory.CreateDirectory(uploadsFolder);
            }
            
            // Generate unique filename with .avif extension
            var fileName = $"{Guid.NewGuid()}.avif";
            var filePath = Path.Combine(uploadsFolder, fileName);
            
            // Read file into memory stream
            using var memoryStream = new MemoryStream();
            await file.OpenReadStream(10 * 1024 * 1024).CopyToAsync(memoryStream);
            memoryStream.Position = 0;
            
            // Convert to AVIF and compress
            await Task.Run(() => 
            {
                using var image = new MagickImage(memoryStream);
                image.Format = MagickFormat.Avif;
                image.Quality = 75; // Compress for web
                image.Write(filePath);
            });
            
            // Set URL
            cv.ImageUrl = $"/images/products/{fileName}";
            Snackbar.Add("Image uploaded and converted to AVIF successfully!", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Upload failed: {ex.Message}", Severity.Error);
        }
    }
}
