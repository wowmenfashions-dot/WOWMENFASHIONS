@page "/admin/homepage"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]
@using wowmenfashions.Services
@using wowmenfashions.Data.Entities
@inject IHomepageConfigService HomepageConfigService
@inject IHomepageImageService HomepageImageService
@inject ISnackbar Snackbar

<PageTitle>Homepage Config | Admin</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="my-8">
    <MudText Typo="Typo.h4" Class="mb-6">Homepage Configuration</MudText>

    <MudPaper Class="pa-6 mb-6">
        <MudText Typo="Typo.h6" Class="mb-4">Announcement Bar</MudText>
        <MudTextField @bind-Value="_announcement" Label="Announcement Text" Variant="Variant.Outlined" Lines="2" Class="mb-4" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAnnouncementAsync">Save Announcement</MudButton>
    </MudPaper>

    <MudPaper Class="pa-6">
        <MudText Typo="Typo.h6" Class="mb-4">Carousel Images</MudText>

        <MudFileUpload T="IReadOnlyList<IBrowserFile>" Accept=".jpg,.jpeg,.png,.webp,.avif" OnFilesChanged="OnFilesSelected" MaximumFileCount="10" AppendMultipleFiles="true">
            <ActivatorContent>
                <MudButton HtmlTag="label"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.CloudUpload">
                    Upload Images
                </MudButton>
            </ActivatorContent>
        </MudFileUpload>

        @if (_uploadedFiles.Any() || _cachedImages.Any())
        {
            <MudList T="string" Class="mt-4">
                @foreach (var img in _cachedImages)
                {
                    <MudListItem>
                        <MudGrid Class="align-center">
                            <MudItem xs="2">
                                <MudImage Src="@($"data:{img.ContentType};base64,{Convert.ToBase64String(img.ImageData)}")" ObjectFit="ObjectFit.Cover" Width="80" Height="40" />
                            </MudItem>
                            <MudItem xs="8">
                                <MudText>Existing Image (Order: @img.DisplayOrder)</MudText>
                            </MudItem>
                            <MudItem xs="2">
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(() => RemoveExistingImage(img))" />
                            </MudItem>
                        </MudGrid>
                    </MudListItem>
                }
                @foreach (var file in _uploadedFiles)
                {
                    <MudListItem>
                        <MudGrid Class="align-center">
                            <MudItem xs="10">
                                <MudText>@file.Name (@Math.Round(file.Size / 1024.0, 1) KB) - Will be processed</MudText>
                            </MudItem>
                            <MudItem xs="2">
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(() => _uploadedFiles.Remove(file))" />
                            </MudItem>
                        </MudGrid>
                    </MudListItem>
                }
            </MudList>
        }

        <div class="d-flex justify-end mt-4">
            <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="SaveCarouselAsync" Disabled="_isSaving">
                @if (_isSaving)
                {
                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true"/>
                    <MudText Class="ms-2">Saving...</MudText>
                }
                else
                {
                    <MudText>Save Carousel</MudText>
                }
            </MudButton>
        </div>
    </MudPaper>
</MudContainer>

@code {
    private string _announcement = string.Empty;
    private List<HomepageImage> _cachedImages = new();
    private List<IBrowserFile> _uploadedFiles = new();
    private bool _isSaving = false;

    protected override async Task OnInitializedAsync()
    {
        _announcement = await HomepageConfigService.GetAnnouncementAsync();
        _cachedImages = await HomepageImageService.GetCachedImagesAsync();
    }

    private async Task SaveAnnouncementAsync()
    {
        try
        {
            await HomepageConfigService.SetAnnouncementAsync(_announcement);
            Snackbar.Add("Announcement updated successfully!", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private void OnFilesSelected(InputFileChangeEventArgs e)
    {
        _uploadedFiles.AddRange(e.GetMultipleFiles(10));
    }

    private void RemoveExistingImage(HomepageImage img)
    {
        _cachedImages.Remove(img);
    }

    private async Task SaveCarouselAsync()
    {
        _isSaving = true;
        StateHasChanged();

        try
        {
            var finalImages = new List<HomepageImage>();
            
            // Keep existing ones
            foreach(var existing in _cachedImages)
            {
                existing.DisplayOrder = finalImages.Count + 1;
                finalImages.Add(existing);
            }

            // Process newly uploaded ones
            foreach(var file in _uploadedFiles)
            {
                using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
                var avifBytes = await HomepageImageService.ProcessImageAsync(stream);
                
                finalImages.Add(new HomepageImage
                {
                    ImageData = avifBytes,
                    ContentType = "image/avif",
                    DisplayOrder = finalImages.Count + 1
                });
            }

            await HomepageImageService.SaveImagesAsync(finalImages);
            _uploadedFiles.Clear();
            _cachedImages = await HomepageImageService.GetCachedImagesAsync();
            Snackbar.Add("Carousel updated and compressed successfully!", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error processing images: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
            StateHasChanged();
        }
    }
}
