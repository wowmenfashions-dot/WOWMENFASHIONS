@page "/aboutus"
@using wowmenfashions.Services
@inject IPageContentService PageContentService

<PageTitle>About Us - WOWMEN FASHIONS</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-16 mb-16 px-4">
    
    <!-- Main Content -->
    <div class="text-center mx-auto mb-16" style="max-width: 900px;">
        <MudText Typo="Typo.h3" Class="fw-bold mb-6">About Us</MudText>
        
        @if (_isLoading)
        {
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        }
        else if (!string.IsNullOrEmpty(_contentHtml))
        {
            @((MarkupString)_contentHtml)
        }
        else
        {
            <MudText Typo="Typo.body1" Class="mb-8 text-muted" Style="line-height: 1.8;">
                WOWMEN Fashions, a beacon of sophistication, is a leading Luxury Leather Bags Manufacturing Company. Renowned for unparalleled craftsmanship, we curate a collection that seamlessly blends luxury with practicality. From opulent wallets to chic accessories, our products are crafted with precision, using only the finest materials. As a brand committed to excellence, we redefine style through timeless designs and ethical practices. WOWMEN Fashions invites you to indulge in the epitome of luxury, where each piece is a testament to our unwavering dedication to creating leather goods that transcend trends and stand the test of time. Elevate your lifestyle with WOWMEN Fashions.
            </MudText>

            <MudText Typo="Typo.h4" Class="fw-bold mb-6">Affordable Luxury Bags</MudText>
            <MudText Typo="Typo.body1" Class="mb-4 text-muted" Style="line-height: 1.8;">
                We believe that every individual deserves to experience the opulence of genuine leather without breaking the bank. That’s why we offer our carefully curated collection of luxury handbags at accessible price points. Elevate your wardrobe and make a statement with a handbag that exudes both style and value.
            </MudText>
            <MudText Typo="Typo.body1" Class="mb-8 text-muted" Style="line-height: 1.8;">
                Experience the allure of affordable luxury. Shop WOWMEN Fashion today.
            </MudText>
        }
    </div>

    <MudDivider Class="mb-16" />

    <!-- 4-Column Feature Highlights -->
    <MudGrid Justify="Justify.Center" Spacing="6" Class="text-center mb-16">
        <MudItem xs="12" sm="6" md="3">
            <MudIcon Icon="@Icons.Material.Outlined.LocalShipping" Style="font-size: 3rem;" Class="mb-4" />
            <MudText Typo="Typo.h6" Class="fw-bold mb-2">Free Shipping</MudText>
            <MudText Typo="Typo.body2" Class="text-muted mb-4">WooCommerce that bring value to your business in Ecommerce.</MudText>
            <MudLink Href="#" Color="Color.Dark" Typo="Typo.caption" Class="fw-bold text-uppercase">Read more</MudLink>
        </MudItem>
        
        <MudItem xs="12" sm="6" md="3">
            <MudIcon Icon="@Icons.Material.Outlined.PhoneIphone" Style="font-size: 3rem;" Class="mb-4" />
            <MudText Typo="Typo.h6" Class="fw-bold mb-2">Mobile App</MudText>
            <MudText Typo="Typo.body2" Class="text-muted mb-4">Elsey can perfectly adapt any type of device based on its screen size.</MudText>
            <MudLink Href="#" Color="Color.Dark" Typo="Typo.caption" Class="fw-bold text-uppercase">Read more</MudLink>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudIcon Icon="@Icons.Material.Outlined.Language" Style="font-size: 3rem;" Class="mb-4" />
            <MudText Typo="Typo.h6" Class="fw-bold mb-2">World Wide</MudText>
            <MudText Typo="Typo.body2" Class="text-muted mb-4">Well structured code ensures smooth experience in search engines.</MudText>
            <MudLink Href="#" Color="Color.Dark" Typo="Typo.caption" Class="fw-bold text-uppercase">Read more</MudLink>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudIcon Icon="@Icons.Material.Outlined.Checkroom" Style="font-size: 3rem;" Class="mb-4" />
            <MudText Typo="Typo.h6" Class="fw-bold mb-2">Fashion Design</MudText>
            <MudText Typo="Typo.body2" Class="text-muted mb-4">Stunning and eye catching design makes your theme attractive.</MudText>
            <MudLink Href="#" Color="Color.Dark" Typo="Typo.caption" Class="fw-bold text-uppercase">Read more</MudLink>
        </MudItem>
    </MudGrid>

    <MudDivider Class="mb-8" />

    <MudText Typo="Typo.body2" Class="text-muted mb-2 text-center">
        Experience affordable luxury with WOWMEN Fashions. Our collection features a range of exquisite leather bags that combine quality craftsmanship with accessible pricing.
    </MudText>
    <MudText Typo="Typo.body2" Class="text-muted text-center">
        Elevate your style and make a statement with our stunning designs.
    </MudText>
</MudContainer>

@code {
    private string _contentHtml = string.Empty;
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        var content = await PageContentService.GetContentByNameAsync("AboutUs");
        _contentHtml = content?.ContentHtml ?? string.Empty;
        _isLoading = false;
    }
}
