@using wowmenfashions.Services
@inject ICartService CartService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<MudCard Elevation="0" Class="product-card mb-2 d-flex flex-column h-100" Style="cursor: pointer; border: 1px solid #e0e0e0; border-radius: 4px;" @onclick="NavigateToProduct">
    <div class="product-image-container position-relative overflow-hidden" style="height: 220px; background-color: #f5f5f5;">
        @if (Product.IsOnSale)
        {
            <MudChip T="string" Color="Color.Error" Size="Size.Small" Class="sale-badge position-absolute" Style="top: 8px; left: 8px; font-size: 10px; height: 20px; z-index: 10;">Sale!</MudChip>
        }
        
        <img src="@(string.IsNullOrWhiteSpace(Product.ImageUrl) ? "https://placehold.co/400x400/e0e0e0/000000.avif?text=No+Image" : Product.ImageUrl)" alt="@Product.Name" style="width: 100%; height: 220px; object-fit: cover;" class="primary-image transition-transform" onerror="this.onerror=null; this.src='https://placehold.co/400x400/e0e0e0/000000.avif?text=No+Image';" />
    </div>
    
    <MudCardContent Class="pt-3 pb-3 px-3 d-flex flex-column flex-grow-1">
        <MudText Typo="Typo.caption" Class="text-muted d-block text-start mb-1" Style="font-size: 0.75rem;">@Product.Category</MudText>
        <MudText Typo="Typo.body2" Class="fw-bold text-dark text-start mb-3 d-block" Style="min-height: 40px;">@Product.Name</MudText>
        
        <div class="d-flex justify-center align-center mt-auto mb-4">
            @if (Product.IsOnSale)
            {
                <MudText Typo="Typo.caption" Style="text-decoration: line-through" Class="me-2 text-muted">@Product.OriginalPrice?.ToString("C")</MudText>
            }
            <MudText Typo="Typo.body1" Class="text-dark">@Product.Price.ToString("C")</MudText>
        </div>

        <div class="w-100" @onclick:stopPropagation="true">
            <MudButton Variant="Variant.Filled" Color="Color.Dark" StartIcon="@Icons.Material.Filled.ShoppingCart" OnClick="AddToCartAsync" FullWidth="true" Class="rounded-0 py-2" Style="background-color: #4a4a4a; font-weight: 600;">
                ADD TO CART
            </MudButton>
        </div>
    </MudCardContent>
</MudCard>

@code {
    [Parameter, EditorRequired]
    public ProductDto Product { get; set; } = null!;

    private void NavigateToProduct()
    {
        Navigation.NavigateTo($"/product/{Product.Id}");
    }

    private async Task AddToCartAsync()
    {
        try
        {
            await CartService.AddItemAsync(Product.Id, 1);
            Snackbar.Add($"{Product.Name} added to cart!", Severity.Success);
        }
        catch (Exception)
        {
            Snackbar.Add("Failed to add to cart.", Severity.Error);
        }
    }
}
