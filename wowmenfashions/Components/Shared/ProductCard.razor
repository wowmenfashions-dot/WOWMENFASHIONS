@using wowmenfashions.Services
@inject ICartService CartService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<MudCard Class="premium-product-card pa-0 h-100 d-flex flex-column" Elevation="0">
    <a href="/product/@Product.Id" class="text-decoration-none d-flex flex-column">
        <div class="premium-image-wrapper pa-4" style="aspect-ratio: 4/5; display: flex; align-items: center; justify-content: center;">
            <img src="@(string.IsNullOrWhiteSpace(CurrentImageUrl) ? "https://placehold.co/500x500/FFFFFF/1E1E1E.avif?text=No+Image" : CurrentImageUrl)" alt="@Product.Name" class="premium-product-image" style="width: 100%; height: 100%; object-fit: contain;" onerror="this.onerror=null; this.src='https://placehold.co/500x500/FFFFFF/1E1E1E.avif?text=No+Image';" />
        </div>
    </a>

    <MudCardContent Class="px-3 py-4 flex-grow-1 d-flex flex-column">
        <!-- Circular Color Swatches -->
        @if (Product.ColorImages != null && Product.ColorImages.Any())
        {
            var distinctColors = Product.ColorImages
                .GroupBy(kvp => kvp.Key.Split('|')[0].Trim())
                .Select(g => new { Color = g.Key, ImageUrl = g.First().Value })
                .ToList();
                
            <div class="d-flex flex-wrap gap-2 mb-3">
                @foreach (var colorData in distinctColors)
                {
                    <div class="premium-color-swatch @(CurrentColorName == colorData.Color ? "active" : "")"
                         style="background-color: @GetCssColor(colorData.Color);"
                         @onmouseenter="@(() => OnColorHover(colorData.Color, colorData.ImageUrl))"
                         @onclick="@(() => OnColorHover(colorData.Color, colorData.ImageUrl))"
                         title="@colorData.Color">
                    </div>
                }
            </div>
        }
        else
        {
            <div style="height: 36px;"></div> <!-- Placeholder to maintain height -->
        }

        <!-- Product Title -->
        <a href="/product/@Product.Id" class="text-decoration-none mb-1">
            <MudText Typo="Typo.h6" Class="fw-bold" Style="color: #1a1a1a; font-size: 1.05rem; line-height: 1.3; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;">@Product.Name</MudText>
        </a>
        
        <div class="mt-auto pt-2">
            <!-- Pricing Section -->
            @if (Product.IsOnSale && Product.OriginalPrice.HasValue)
            {
                <div class="d-flex align-center gap-2 mb-1">
                    <MudText Typo="Typo.body1" Class="fw-bold text-dark">@Product.Price.ToString("C")</MudText>
                    <MudText Typo="Typo.body2" Class="text-muted text-decoration-line-through">@Product.OriginalPrice.Value.ToString("C")</MudText>
                </div>
            }
            else
            {
                <MudText Typo="Typo.body1" Class="fw-bold text-dark mb-1">@Product.Price.ToString("C")</MudText>
            }

            <!-- Dynamic Ratings -->
            <div class="d-flex align-center mt-2 mb-3">
                @if (Product.ReviewCount > 0)
                {
                    <MudRating SelectedValue="@((int)Math.Round(Product.AverageRating))" Max="5" Size="Size.Small" ReadOnly="true" Color="Color.Warning" />
                    <MudText Typo="Typo.caption" Class="text-muted ms-2">@Product.AverageRating.ToString("0.1") (@Product.ReviewCount)</MudText>
                }
                else
                {
                    <MudRating SelectedValue="0" Max="5" Size="Size.Small" ReadOnly="true" Color="Color.Default" />
                    <MudText Typo="Typo.caption" Class="text-muted ms-2">No reviews yet</MudText>
                }
            </div>
        </div>
    </MudCardContent>

    <MudCardActions Class="px-3 pb-4 pt-0 mt-auto justify-center">
        <MudButton Href="@($"/product/{Product.Id}")" Variant="Variant.Outlined" Color="Color.Dark" FullWidth="true" Class="py-2 fw-bold" Style="border-width: 1.5px; border-radius: 9999px;">
            View Details
        </MudButton>
    </MudCardActions>
</MudCard>

@code {
    [Parameter, EditorRequired]
    public ProductDto Product { get; set; } = null!;

    private string CurrentImageUrl = string.Empty;
    private string CurrentColorName = "Black";

    private int _lastProductId = -1;

    protected override void OnParametersSet()
    {
        if (_lastProductId != Product.Id)
        {
            _lastProductId = Product.Id;
            if (Product.ColorImages != null && Product.ColorImages.Any())
            {
                CurrentColorName = Product.ColorImages.Keys.First().Split('|')[0].Trim();
                var images = Product.ColorImages.Values.First();
                CurrentImageUrl = images?.Split(',', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault()?.Trim() ?? string.Empty;
            }
            else
            {
                CurrentColorName = string.Empty;
                CurrentImageUrl = Product.ImageUrl?.Split(',', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault()?.Trim() ?? "";
            }
        }
    }

    private void OnColorHover(string colorName, string? newImage)
    {
        CurrentColorName = colorName;
        // If a new image is provided, use it. Otherwise fallback to the primary image.
        CurrentImageUrl = !string.IsNullOrWhiteSpace(newImage) 
            ? (newImage.Split(',', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault()?.Trim() ?? "") 
            : (Product.ImageUrl?.Split(',', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault()?.Trim() ?? "");
            
        StateHasChanged();
    }

    private string GetCssColor(string colorName)
    {
        if (string.IsNullOrWhiteSpace(colorName)) return "#000";
        // Convert names like "Royal Blue" to "royalblue" which is a valid CSS named color
        return colorName.ToLower().Replace(" ", "");
    }
}
