@using wowmenfashions.Services
@inject ICartService CartService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<MudCard Elevation="0" Class="product-card mb-2 d-flex flex-column h-100" Style="background: transparent; border-radius: 0;">
    <a href="/product/@Product.Id" class="text-decoration-none d-flex flex-column flex-grow-1">
        <div class="product-image-container position-relative overflow-hidden gallery-image" style="height: 300px; background-color: #F3F4F6; border-radius: 16px;">
            @if (Product.IsOnSale)
            {
                <MudChip T="string" Color="Color.Error" Size="Size.Small" Class="sale-badge" Style="position: absolute; top: 12px; left: 12px; font-size: 10px; height: 24px; z-index: 10; border-radius: 9999px; font-weight: 600;">Sale!</MudChip>
            }
            
            <img src="@(string.IsNullOrWhiteSpace(Product.ImageUrl) ? "https://placehold.co/400x400/F3F4F6/1E1E1E.avif?text=No+Image" : Product.ImageUrl)" alt="@Product.Name" style="width: 100%; height: 100%; object-fit: cover;" class="primary-image transition-transform" onerror="this.onerror=null; this.src='https://placehold.co/400x400/F3F4F6/1E1E1E.avif?text=No+Image';" />
        </div>
        
        <MudCardContent Class="pt-3 pb-3 px-1 d-flex flex-column flex-grow-1">
            <MudText Typo="Typo.caption" Class="d-block text-start mb-1" Style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.5px; color: #6B7280;">@Product.Category</MudText>
            <MudText Typo="Typo.body2" Class="fw-bold text-start mb-2 d-block" Style="min-height: 20px; color: #1E1E1E; font-weight: 500;">@Product.Name</MudText>
            
            <div class="d-flex justify-start align-center mt-auto">
                @if (Product.IsOnSale)
                {
                    <MudText Typo="Typo.caption" Style="text-decoration: line-through; color: #6B7280;" Class="me-2">@Product.OriginalPrice?.ToString("C")</MudText>
                }
                <MudText Typo="Typo.body1" Class="fw-bold" Style="color: #1E1E1E;">@Product.Price.ToString("C")</MudText>
            </div>
        </MudCardContent>
    </a>
    
    <div class="px-1 pb-3 w-100 mt-2">
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" OnClick="AddToCartAsync" FullWidth="true" Class="rounded-pill" Style="font-weight: 600;">
            Add to Cart
        </MudButton>
    </div>
</MudCard>

@code {
    [Parameter, EditorRequired]
    public ProductDto Product { get; set; } = null!;

    private void NavigateToProduct()
    {
        Navigation.NavigateTo($"/product/{Product.Id}");
    }

    private async Task AddToCartAsync()
    {
        try
        {
            await CartService.AddItemAsync(Product.Id, 1);
            Snackbar.Add($"{Product.Name} added to cart!", Severity.Success);
        }
        catch (Exception)
        {
            Snackbar.Add("Failed to add to cart.", Severity.Error);
        }
    }
}
