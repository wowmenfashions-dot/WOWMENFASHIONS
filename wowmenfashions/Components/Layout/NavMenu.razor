<MudNavMenu Margin="Margin.Dense">
    <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.Home" IconColor="Color.Primary">Home</MudNavLink>
    <MudNavLink Href="/category/mens" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Male" IconColor="Color.Primary">Men's</MudNavLink>
    <MudNavLink Href="/category/womens" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Female" IconColor="Color.Primary">Women's</MudNavLink>
    <MudNavLink Href="/category/kids" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Toys" IconColor="Color.Primary">Kids</MudNavLink>
    <MudNavLink Href="/category/toddler" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.ChildFriendly" IconColor="Color.Primary">Toddler</MudNavLink>
    <MudNavLink Href="/aboutus" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.Info" IconColor="Color.Primary">About Us</MudNavLink>
    <MudNavLink Href="/contactus" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.ContactPage" IconColor="Color.Primary">Contact Us</MudNavLink>
    <MudNavLink Href="/terms" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.Gavel" IconColor="Color.Primary">Terms & Conditions</MudNavLink>
    <AuthorizeView>
        <Authorized>
            <AuthorizeView Roles="Admin" Context="adminContext">
                <MudNavLink Href="/admin" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.Dashboard" IconColor="Color.Primary">Admin Dashboard</MudNavLink>
                <MudNavLink Href="/admin/products/new" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.AddBox" IconColor="Color.Primary">New Product</MudNavLink>
                <MudNavLink Href="/admin/homepage" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.Settings" IconColor="Color.Primary">Homepage Settings</MudNavLink>
                <MudNavLink Href="/admin/messages" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.Message" IconColor="Color.Primary">Contact Messages</MudNavLink>
                <MudNavLink Href="/admin/pages" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.Article" IconColor="Color.Primary">Edit Pages</MudNavLink>
                <MudNavLink Href="/admin/store-settings" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.SettingsApplications" IconColor="Color.Primary">Store Settings</MudNavLink>
            </AuthorizeView>
            <MudNavLink Href="account/profile" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.AccountCircle" IconColor="Color.Primary">Profile</MudNavLink>
            <MudNavLink Href="/api/auth/logout" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.ExitToApp" IconColor="Color.Primary">Logout</MudNavLink>
        </Authorized>
        <NotAuthorized>
            <MudNavLink Href="login" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.Login" IconColor="Color.Primary">Login</MudNavLink>
            <MudNavLink Href="register" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.PersonAdd" IconColor="Color.Primary">Register</MudNavLink>
        </NotAuthorized>
    </AuthorizeView>
</MudNavMenu>

